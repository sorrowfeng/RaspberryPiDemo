[Unit]
Description=LHandPro RaspberryPiDemo (dexterous hand control)
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/RaspberryPiDemo
ExecStart=/usr/bin/python3 /opt/RaspberryPiDemo/launch.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
